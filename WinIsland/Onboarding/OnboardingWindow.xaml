<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinIsland.Onboarding.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WinIsland 新手引导"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="WinIsland" Subtitle="新手引导">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <StackPanel
            x:Name="StepHeader"
            Grid.Row="1"
            Padding="32,10,32,4"
            Spacing="8">
            <TextBlock x:Name="StepTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="欢迎使用" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <StackPanel
                    x:Name="StepDots"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6" />
                <TextBlock
                    x:Name="StepCounter"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="第 1 步 / 共 6 步" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer
            x:Name="ContentScroll"
            Grid.Row="2"
            Padding="32,12,32,16"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <!--  单格 Grid：所有步骤重叠在同一格，切换时新旧两页可以做交叉动画而不引起布局跳动  -->
            <Grid x:Name="StepHost" MaxWidth="720">

                <!--  ① 欢迎  -->
                <StackPanel x:Name="StepWelcome" Spacing="12">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Grid x:Name="WelcomeDiagram" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="WinIsland 是常驻桌面的灵动岛" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="媒体、电量、硬件、天气……由插件提供内容，宿主负责外观与交互。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock FontWeight="SemiBold" Text="基本操作" />
                            <Grid ColumnSpacing="10" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Ellipse
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="#007AFF" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontSize="13"
                                    TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="悬停展开：" />
                                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="鼠标移到岛上，展开显示更多内容。" />
                                </TextBlock>

                                <Ellipse
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="#007AFF" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontSize="13"
                                    TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="大卡：" />
                                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="点击岛上的卡片打开聚光卡，Esc 或点击卡片外部收起。" />
                                </TextBlock>

                                <Ellipse
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="#007AFF" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    FontSize="13"
                                    TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="托盘：" />
                                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="右键托盘图标可打开设置、显示/隐藏、退出。" />
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="接下来用一分钟完成初始设置：位置、外观、开机自启和几个推荐插件。随时可以在 设置 → 通用 里重新打开本引导。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  ② 岛位置  -->
                <StackPanel
                    x:Name="StepPosition"
                    Spacing="12"
                    Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="位置" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="贴屏幕顶部，或嵌进 Windows 任务栏（嵌入后展开向上生长）"
                                TextWrapping="Wrap" />
                            <Grid x:Name="PositionCards" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="水平对齐" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="岛在屏幕上横向贴哪一边"
                                TextWrapping="Wrap" />
                            <Grid x:Name="HorizontalCards" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="改动立即生效——看一眼屏幕上的灵动岛，它已经动起来了。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  ③ 外观与材质  -->
                <StackPanel
                    x:Name="StepAppearance"
                    Spacing="12"
                    Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="外观风格" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Apple 灵动岛：纯黑胶囊；Windows Fluent：系统材质与更小的圆角"
                                TextWrapping="Wrap" />
                            <Grid x:Name="StyleCards" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Fluent 材质" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="仅 Windows Fluent 风格生效；不支持的系统自动回退纯色"
                                TextWrapping="Wrap" />
                            <Grid x:Name="MaterialCards" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="选中的外观会立刻应用到屏幕上的岛，挑一个顺眼的就行。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  ④ 开机自启动  -->
                <StackPanel
                    x:Name="StepAutoStart"
                    Spacing="12"
                    Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="开机自启动" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="普通权限：登录后直接启动；管理员权限：创建「最高权限运行」的登录计划任务"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="AutoStartStatus"
                                Margin="0,4,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <Grid x:Name="AutoStartCards" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="选择「管理员权限自启动」时会弹一次 UAC 授权确认，等待期间应用保持可用；取消授权不会改变当前设置。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  ⑤ 推荐插件  -->
                <StackPanel
                    x:Name="StepPlugins"
                    Spacing="12"
                    Visibility="Collapsed">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="插件市场里的插件，点「安装」即可直接装上；也可以稍后在 设置 → 插件市场 里浏览全部。"
                        TextWrapping="Wrap" />
                    <InfoBar
                        x:Name="PluginStatus"
                        IsClosable="False"
                        IsOpen="False" />
                    <StackPanel x:Name="RecommendList" Spacing="8" />
                </StackPanel>

                <!--  ⑥ 系统托盘与设置  -->
                <StackPanel
                    x:Name="StepTray"
                    Spacing="12"
                    Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock FontWeight="SemiBold" Text="系统托盘" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="WinIsland 常驻系统托盘（右下角通知区域，可能需要点开「^」小箭头）。右键弹出菜单："
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="10" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Ellipse
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="#007AFF" />
                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="13" Text="打开设置" />

                                <Ellipse
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="#007AFF" />
                                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="13" Text="显示灵动岛（勾选项，控制岛的显示 / 隐藏）" />

                                <Ellipse
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="#007AFF" />
                                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="13" Text="退出 WinIsland" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="随时打开设置" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="双击托盘图标，或右键菜单第一项；里面有通用、插件市场、插件管理三个页面"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="OpenSettings_Click"
                                Content="打开设置" />
                        </Grid>
                    </Border>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="引导到此结束，祝你用得愉快！"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="3" Padding="32,12,32,20">
            <HyperlinkButton
                x:Name="SkipButton"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Click="Skip_Click"
                Content="跳过引导" />
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="BackButton"
                    Click="Back_Click"
                    Content="上一步" />
                <Button
                    x:Name="NextButton"
                    Click="Next_Click"
                    Content="下一步"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
