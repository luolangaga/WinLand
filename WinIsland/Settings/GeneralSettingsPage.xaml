<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinIsland.Settings.GeneralSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="通用" />
        <TextBlock
            Margin="0,0,0,12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="灵动岛外观与行为" />

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="4">
                <TextBlock Text="外观风格" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Apple 灵动岛：纯黑胶囊；Windows Fluent：系统材质与更小的圆角"
                    TextWrapping="Wrap" />
                <Grid x:Name="StyleCards" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="4">
                <TextBlock Text="Fluent 材质" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="仅 Windows Fluent 风格生效；不支持的系统自动回退纯色"
                    TextWrapping="Wrap" />
                <Grid x:Name="MaterialCards" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="显示灵动岛" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="在屏幕中央（顶部或底部）显示悬浮胶囊"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    x:Name="VisibleToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    OffContent=""
                    OnContent=""
                    Toggled="VisibleToggle_Toggled" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="空闲时隐藏" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="没有任何内容时自动隐藏胶囊"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    x:Name="HideIdleToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    OffContent=""
                    OnContent=""
                    Toggled="HideIdleToggle_Toggled" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="文件投放" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="把文件/文件夹拖到岛上时展开成一排投放卡片，松手执行对应动作"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    x:Name="DropToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    OffContent=""
                    OnContent=""
                    Toggled="DropToggle_Toggled" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="4">
                <TextBlock Text="位置" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="贴屏幕顶部，或嵌进底部任务栏（展开向上生长，队列排到岛体上方）"
                    TextWrapping="Wrap" />
                <Grid x:Name="PositionCards" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="4">
                <TextBlock Text="水平对齐" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="岛在屏幕上横向贴哪一边；嵌入任务栏时会自动落在任务栏的空闲段里"
                    TextWrapping="Wrap" />
                <Grid x:Name="HorizontalCards" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="OffsetTitle" Text="顶部偏移" />
                    <TextBlock
                        x:Name="OffsetHint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="灵动岛距离屏幕顶部的距离 (px)"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Slider
                    x:Name="OffsetSlider"
                    Grid.Column="1"
                    Width="200"
                    Maximum="80"
                    Minimum="0"
                    StepFrequency="2"
                    VerticalAlignment="Center"
                    ValueChanged="OffsetSlider_ValueChanged" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="水平偏移" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="在上面对齐落点上再左右微调：负值向左、正值向右 (px)"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Slider
                    x:Name="HorizontalOffsetSlider"
                    Grid.Column="1"
                    Width="200"
                    Maximum="500"
                    Minimum="-500"
                    StepFrequency="2"
                    VerticalAlignment="Center"
                    ValueChanged="HorizontalOffsetSlider_ValueChanged" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="4">
                <TextBlock Text="开机自启动" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="普通权限：登录后直接启动；管理员权限：创建「最高权限运行」的登录计划任务（设置时会弹一次 UAC 确认）"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="AutoStartStatus"
                    Margin="0,4,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
                <Grid x:Name="AutoStartCards" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="新手引导" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="重新查看位置、外观、自启、推荐插件与系统托盘的介绍"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="RunOnboarding_Click"
                    Content="重新运行新手引导" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
