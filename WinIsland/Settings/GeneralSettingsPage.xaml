<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinIsland.Settings.GeneralSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="通用" />
        <TextBlock
            Margin="0,0,0,12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="外观、位置与交互，按你的方式运行。" />

        <TextBlock Style="{StaticResource SettingsSectionHeadingStyle}" Text="外观与材质" />

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="4">
                <TextBlock Text="外观风格" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Apple 灵动岛：纯黑胶囊；Windows Fluent：系统材质与更小的圆角"
                    TextWrapping="Wrap" />
                <Grid x:Name="StyleCards" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="4">
                <TextBlock Text="Fluent 材质" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="仅 Windows Fluent 风格生效；不支持的系统自动回退纯色"
                    TextWrapping="Wrap" />
                <Grid x:Name="MaterialCards" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="外观微调" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="圆角比例 (%)" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="100% 为风格默认圆角；同时作用于岛体、展开队列与聚光卡"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Slider
 AutomationProperties.AutomationId="RadiusSlider"                        x:Name="RadiusSlider"
                        Grid.Column="1"
                        Width="200"
                        Maximum="200"
                        Minimum="0"
                        StepFrequency="5"
                        VerticalAlignment="Center"
                        ValueChanged="RadiusSlider_ValueChanged" />
                </Grid>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="不透明度 (%)" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="作用于岛体、展开队列与聚光卡；Fluent 系统材质本身不随此调淡（材质由系统绘制）"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Slider
 AutomationProperties.AutomationId="OpacitySlider"                        x:Name="OpacitySlider"
                        Grid.Column="1"
                        Width="200"
                        Maximum="100"
                        Minimum="10"
                        StepFrequency="5"
                        VerticalAlignment="Center"
                        ValueChanged="OpacitySlider_ValueChanged" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SettingsSectionHeadingStyle}" Text="日常交互" />

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="显示灵动岛" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="在屏幕中央（顶部或底部）显示悬浮胶囊"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
 AutomationProperties.AutomationId="VisibleToggle"                    x:Name="VisibleToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    OffContent=""
                    OnContent=""
                    Toggled="VisibleToggle_Toggled" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <ToggleSwitch x:Name="IdleEdgeToggle" Header="空闲时贴边隐藏（靠近屏幕边缘唤出）" Toggled="IdleEdgeToggle_Toggled" />
        </Border>
        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="空闲时隐藏" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="没有任何内容时自动隐藏胶囊"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
 AutomationProperties.AutomationId="HideIdleToggle"                    x:Name="HideIdleToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    OffContent=""
                    OnContent=""
                    Toggled="HideIdleToggle_Toggled" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="活动岛数量" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="有多个活动岛时，在主岛旁显示数字圆点（包含未显示的队列卡片）"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="ActivityCountToggle"
                              Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                              AutomationProperties.AutomationId="ActivityCountToggle"
                              AutomationProperties.Name="显示活动岛数量"
                              OffContent="" OnContent=""
                              Toggled="ActivityCountToggle_Toggled" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="悬停展开" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="鼠标停在岛上就展开；关掉后改为点击岛体（或触控轻点）展开，点岛外收起"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
 AutomationProperties.AutomationId="HoverExpandToggle"                    x:Name="HoverExpandToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    OffContent=""
                    OnContent=""
                    Toggled="HoverExpandToggle_Toggled" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="悬停展开延迟" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="鼠标只是从岛边扫过时不展开：停在岛上满这么久才展开 (ms)"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Slider
 AutomationProperties.AutomationId="HoverDelaySlider"                    x:Name="HoverDelaySlider"
                    Grid.Column="1"
                    Width="200"
                    Maximum="600"
                    Minimum="0"
                    StepFrequency="50"
                    VerticalAlignment="Center"
                    ValueChanged="HoverDelaySlider_ValueChanged" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="展开回弹" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="展开时轻盈回弹，收起时平稳缓出；关闭后使用柔和的缓出动画"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
 AutomationProperties.AutomationId="BounceToggle"                    x:Name="BounceToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    OffContent=""
                    OnContent=""
                    Toggled="BounceToggle_Toggled" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="文件投放" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="把文件/文件夹拖到岛上时展开成一排投放卡片，松手执行对应动作"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
 AutomationProperties.AutomationId="DropToggle"                    x:Name="DropToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    OffContent=""
                    OnContent=""
                    Toggled="DropToggle_Toggled" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="勿扰" />
                    <TextBlock
                        x:Name="QuietHint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="静默期间不弹临时消息、也不因新活动自动现身；消息照样记进历史"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox
                        x:Name="QuietCombo"
                        MinWidth="120"
                        AutomationProperties.AutomationId="QuietCombo"
                        AutomationProperties.Name="静默时长"
                        SelectionChanged="QuietCombo_SelectionChanged">
                        <ComboBoxItem Content="15 分钟" />
                        <ComboBoxItem Content="30 分钟" />
                        <ComboBoxItem Content="1 小时" />
                        <ComboBoxItem Content="2 小时" />
                    </ComboBox>
                    <Button
                        x:Name="QuietButton"
                        AutomationProperties.AutomationId="QuietButton"
                        Click="QuietButton_Click"
                        Content="开始静默" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="手动位置" />
                    <TextBlock
                        x:Name="DragPlacementHint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="按住 Alt 再拖岛体（或按住中键拖动）可以把它摆到任意位置；改了位置/对齐设置会自动回到自动落位"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Name="ResetPlacementButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ResetPlacementButton"
                    Click="ResetPlacement_Click"
                    Content="恢复自动对齐"
                    IsEnabled="False" />
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource SettingsSectionHeadingStyle}" Text="全屏与缩放" />

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="4">
                <TextBlock Text="全屏应用时" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="游戏、视频等全屏软件占满屏幕时灵动岛怎么办：隐藏岛体并在屏幕边缘留一条小色条（鼠标靠近即展开）、完全隐藏，或照常显示"
                    TextWrapping="Wrap" />
                <Grid x:Name="FullscreenCards" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="界面缩放 (%)" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="灵动岛" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="活动、展开队列、消息、投放面板的整体大小"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Slider
 AutomationProperties.AutomationId="ScaleIslandSlider"                        x:Name="ScaleIslandSlider"
                        Grid.Column="1"
                        Width="200"
                        Maximum="200"
                        Minimum="50"
                        StepFrequency="5"
                        VerticalAlignment="Center"
                        ValueChanged="ScaleSlider_ValueChanged" />
                </Grid>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="空闲小岛" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="没有活动时那颗小胶囊的大小"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Slider
 AutomationProperties.AutomationId="ScaleIdleSlider"                        x:Name="ScaleIdleSlider"
                        Grid.Column="1"
                        Width="200"
                        Maximum="200"
                        Minimum="50"
                        StepFrequency="5"
                        VerticalAlignment="Center"
                        ValueChanged="ScaleSlider_ValueChanged" />
                </Grid>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="全屏小色条" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="全屏应用时贴在屏幕边缘的色条大小"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Slider
 AutomationProperties.AutomationId="ScaleStripSlider"                        x:Name="ScaleStripSlider"
                        Grid.Column="1"
                        Width="200"
                        Maximum="200"
                        Minimum="50"
                        StepFrequency="5"
                        VerticalAlignment="Center"
                        ValueChanged="ScaleSlider_ValueChanged" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SettingsSectionHeadingStyle}" Text="位置与屏幕" />

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="4">
                <TextBlock Text="显示器" />
                <TextBlock
                    x:Name="DisplayHint"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="岛锚定在哪块屏幕：跟随鼠标光标，或固定某一台。多屏热插拔时会自动重新定位"
                    TextWrapping="Wrap" />
                <Grid x:Name="DisplayCards" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="4">
                <TextBlock Text="位置" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="贴屏幕顶部，或嵌进底部任务栏（展开向上生长，队列排到岛体上方）"
                    TextWrapping="Wrap" />
                <Grid x:Name="PositionCards" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="4">
                <TextBlock Text="水平对齐" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="岛在屏幕上横向贴哪一边；嵌入任务栏时会自动落在任务栏的空闲段里"
                    TextWrapping="Wrap" />
                <Grid x:Name="HorizontalCards" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="OffsetTitle" Text="顶部偏移" />
                    <TextBlock
                        x:Name="OffsetHint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="灵动岛距离屏幕顶部的距离 (px)"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Slider
 AutomationProperties.AutomationId="OffsetSlider"                    x:Name="OffsetSlider"
                    Grid.Column="1"
                    Width="200"
                    Maximum="2000"
                    Minimum="-2000"
                    StepFrequency="2"
                    VerticalAlignment="Center"
                    ValueChanged="OffsetSlider_ValueChanged" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="水平偏移" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="在上面对齐落点上再左右微调：负值向左、正值向右 (px)"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Slider
 AutomationProperties.AutomationId="HorizontalOffsetSlider"                    x:Name="HorizontalOffsetSlider"
                    Grid.Column="1"
                    Width="200"
                    Maximum="4000"
                    Minimum="-4000"
                    StepFrequency="2"
                    VerticalAlignment="Center"
                    ValueChanged="HorizontalOffsetSlider_ValueChanged" />
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource SettingsSectionHeadingStyle}" Text="启动与引导" />

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="4">
                <TextBlock Text="开机自启动" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="普通权限：登录后直接启动；管理员权限：创建「最高权限运行」的登录计划任务（设置时会弹一次 UAC 确认）"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="AutoStartStatus"
                    Margin="0,4,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
                <Grid x:Name="AutoStartCards" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="新手引导" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="重新查看位置、外观、自启、推荐插件与系统托盘的介绍"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="RunOnboarding_Click"
                    Content="重新运行新手引导" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
