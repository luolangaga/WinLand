<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinIsland.Island.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WinIsland"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent" RequestedTheme="Dark">
        <StackPanel
            x:Name="IslandStack"
            Margin="0,24,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="8"
            PointerEntered="IslandStack_PointerEntered"
            PointerExited="IslandStack_PointerExited">
            <Border
                x:Name="IslandRoot"
                HorizontalAlignment="Center"
                Background="#FF000000"
                CornerRadius="17"
                PointerEntered="IslandRoot_PointerEntered"
                PointerExited="IslandRoot_PointerExited"
                Tapped="IslandRoot_Tapped">
                <ContentPresenter x:Name="ContentHost" />
            </Border>
            <StackPanel
                x:Name="QueuePanel"
                HorizontalAlignment="Center"
                Spacing="6"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
