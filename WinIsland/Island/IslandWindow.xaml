<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinIsland.Island.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WinIsland"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent" RequestedTheme="Dark">
        <!-- 岛体栈：两行 Auto 行，行序按 island.position 运行时切换。
             顶部模式：主岛第 0 行、队列第 1 行（向下排列）；
             底部模式：队列第 0 行、主岛第 1 行（向上排列）。
             用改行号而不是重挂子元素，避免 IslandRoot 被 Unloaded/Loaded 导致内容重挂。 -->
        <Grid
            x:Name="IslandStack"
            Margin="0,24,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            RowSpacing="8"
            PointerEntered="IslandStack_PointerEntered"
            PointerExited="IslandStack_PointerExited">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                x:Name="IslandRoot"
                Grid.Row="0"
                AllowDrop="True"
                HorizontalAlignment="Center"
                Background="#FF000000"
                CornerRadius="17"
                DragEnter="IslandRoot_DragEnter"
                DragLeave="IslandRoot_DragLeave"
                DragOver="IslandRoot_DragOver"
                Drop="IslandRoot_Drop"
                PointerEntered="IslandRoot_PointerEntered"
                PointerExited="IslandRoot_PointerExited"
                Tapped="IslandRoot_Tapped">
                <Grid>
                    <ContentPresenter x:Name="ContentHost" />
                    <!-- 内容交接层：换内容时旧内容按原尺寸钉在这里淡出（见 IslandWindow.SwapContent）。
                         永远不吃命中，也不参与布局 —— 只是一个正在退场的快照。 -->
                    <ContentPresenter
                        x:Name="ContentLeaving"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Opacity="0" />
                </Grid>
            </Border>
            <StackPanel
                x:Name="QueuePanel"
                Grid.Row="1"
                HorizontalAlignment="Center"
                Spacing="6"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
