<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinIsland.Modules.Messaging.MessageSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="发送消息" />
        <TextBlock
            Margin="0,0,0,12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="手动向灵动岛发送一条消息，体验消息展示效果" />

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="12">
                <TextBox
                    x:Name="TitleBox"
                    Header="标题"
                    PlaceholderText="例如：新消息"
                    Text="你好，灵动岛 👋" />
                <TextBox
                    x:Name="BodyBox"
                    Header="正文（可空）"
                    AcceptsReturn="True"
                    PlaceholderText="消息正文"
                    Text="这是一条来自 WinIsland 的测试消息"
                    TextWrapping="Wrap" />
                <NumberBox
                    x:Name="DurationBox"
                    Width="200"
                    HorizontalAlignment="Left"
                    Header="展示时长（秒）"
                    Maximum="60"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    Value="4" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        Click="Send_Click"
                        Content="发送到灵动岛"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button Click="SendCustom_Click" Content="展示自定义 XAML 控件" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
