<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinIsland.Modules.Media.MediaIslandView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 岛体在浅色主题（Fluent）下是浅底，插件自己的中性色也必须成对给出：
                 只写死一套白色，浅色岛上就是白字压白底（文字直接用系统画刷，见下方 ThemeResource） -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="MediaNeutralFillBrush" Color="#33000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="MediaNeutralFillBrush" Color="#33FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="TransportButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>
            <!-- 标题的两个档位：展开态更亮一档，代码里按形态切换 Style。
                 颜色必须留在 Style 里走 ThemeResource —— 代码里直接赋 Foreground 会打断主题引用，
                 浅色主题下就变成白字压白底。 -->
            <Style x:Key="TitleCompactStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="TitleExpandedStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 单一变形视图：所有元素常驻可视树，
         紧凑↔展开之间动画各元素的位置/尺寸/透明度，实现 iOS 风格的流畅变形 -->
    <Grid x:Name="RootGrid" Padding="8,0,14,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 节奏光晕层（展开态播放时随实时音频频段能量脉动） -->
        <Grid x:Name="GlowLayer" Grid.RowSpan="2" Opacity="0" IsHitTestVisible="False">
            <!-- 低频光晕：深紫蓝，鼓点 punch — 大范围扩散 -->
            <Ellipse x:Name="Glow1" RenderTransformOrigin="0.3,0.5" Opacity="0.40">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="Glow1Scale" ScaleX="0.50" ScaleY="0.50" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#C06366F1" Offset="0" />
                        <GradientStop Color="#406366F1" Offset="0.3" />
                        <GradientStop Color="#006366F1" Offset="0.75" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- 中频光晕：青绿 — 中等扩散 -->
            <Ellipse x:Name="Glow2" RenderTransformOrigin="0.7,0.4" Opacity="0.35">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="Glow2Scale" ScaleX="0.45" ScaleY="0.45" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#B014B8A6" Offset="0" />
                        <GradientStop Color="#3014B8A6" Offset="0.3" />
                        <GradientStop Color="#0014B8A6" Offset="0.7" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- 高频光晕：暖粉 — 小范围闪烁 -->
            <Ellipse x:Name="Glow3" RenderTransformOrigin="0.5,0.7" Opacity="0.30">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="Glow3Scale" ScaleX="0.40" ScaleY="0.40" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A0F472B0" Offset="0" />
                        <GradientStop Color="#30F472B0" Offset="0.3" />
                        <GradientStop Color="#00F472B0" Offset="0.65" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- 主行：封面 + 标题/艺术家 + 音频条 -->
        <Grid x:Name="MainGrid" Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 封面：紧凑 26x26 → 展开 72x72，CornerRadius 7→14 -->
            <Border
                x:Name="Cover"
                Width="26"
                Height="26"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{ThemeResource MediaNeutralFillBrush}"
                CornerRadius="7">
                <Grid>
                    <FontIcon
                        x:Name="PlaceholderIcon"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Glyph="&#xE8D6;"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.PlaceholderVisibility, Mode=OneWay}" />
                    <Image
                        Source="{x:Bind ViewModel.Thumbnail, Mode=OneWay}"
                        Stretch="UniformToFill"
                        Visibility="{x:Bind ViewModel.ThumbnailVisibility, Mode=OneWay}" />
                </Grid>
            </Border>

            <!-- 标题 + 艺术家 + 来源应用 -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    x:Name="Title"
                    FontSize="12"
                    Style="{StaticResource TitleCompactStyle}"
                    MaxLines="1"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="Artist"
                    Height="0"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    MaxLines="1"
                    Opacity="0"
                    Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel
                    x:Name="SourceAppRow"
                    Height="0"
                    Opacity="0"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
                    <Image
                        x:Name="SourceAppIconImg"
                        Width="12"
                        Height="12"
                        VerticalAlignment="Center"
                        Source="{x:Bind ViewModel.SourceAppIcon, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.SourceAppIconVisibility, Mode=OneWay}" />
                    <TextBlock
                        x:Name="SourceAppText"
                        FontSize="10"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        MaxLines="1"
                        Text="{x:Bind ViewModel.SourceAppName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- 跳动的音频条（紧凑态可见） -->
            <StackPanel
                x:Name="Bars"
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">
                <Rectangle
                    x:Name="Bar1"
                    Width="3"
                    Height="8"
                    VerticalAlignment="Center"
                    Fill="#FF6CCB5F"
                    RadiusX="1.5"
                    RadiusY="1.5" />
                <Rectangle
                    x:Name="Bar2"
                    Width="3"
                    Height="14"
                    VerticalAlignment="Center"
                    Fill="#FF6CCB5F"
                    RadiusX="1.5"
                    RadiusY="1.5" />
                <Rectangle
                    x:Name="Bar3"
                    Width="3"
                    Height="10"
                    VerticalAlignment="Center"
                    Fill="#FF6CCB5F"
                    RadiusX="1.5"
                    RadiusY="1.5" />
            </StackPanel>
        </Grid>

        <!-- 播控（展开态可见）+ 会话切换 -->
        <Grid x:Name="ControlsRow" Grid.Row="1" Height="0" Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="PrevSessionBtn"
                Grid.Column="0"
                Click="PrevSession_Click"
                Style="{StaticResource TransportButtonStyle}"
                Padding="6"
                Visibility="{x:Bind ViewModel.SwitcherVisibility, Mode=OneWay}">
                <FontIcon FontSize="12" Glyph="&#xE76B;" />
            </Button>
            <StackPanel
                x:Name="Controls"
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="18">
                <Button Click="Previous_Click" Style="{StaticResource TransportButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE892;" />
                </Button>
                <Button Click="PlayPause_Click" Style="{StaticResource TransportButtonStyle}">
                    <FontIcon FontSize="20" Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" />
                </Button>
                <Button Click="Next_Click" Style="{StaticResource TransportButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE893;" />
                </Button>
            </StackPanel>
            <Button
                x:Name="NextSessionBtn"
                Grid.Column="2"
                Click="NextSession_Click"
                Style="{StaticResource TransportButtonStyle}"
                Padding="6"
                Visibility="{x:Bind ViewModel.SwitcherVisibility, Mode=OneWay}">
                <FontIcon FontSize="12" Glyph="&#xE76C;" />
            </Button>
        </Grid>

        <!-- 进度条（展开态可见，媒体支持时才显示） -->
        <Grid
            x:Name="ProgressRow"
            Grid.Row="2"
            Height="0"
            Opacity="0"
            ColumnSpacing="6"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="PositionText"
                Grid.Column="0"
                FontSize="10"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
            <Grid
                x:Name="ProgressArea"
                Grid.Column="1"
                Height="12"
                Background="Transparent"
                PointerCaptureLost="ProgressArea_PointerCaptureLost"
                PointerMoved="ProgressArea_PointerMoved"
                PointerPressed="ProgressArea_PointerPressed"
                PointerReleased="ProgressArea_PointerReleased"
                Tapped="ProgressArea_Tapped"
                VerticalAlignment="Center">
                <Border
                    Height="4"
                    VerticalAlignment="Center"
                    Background="{ThemeResource MediaNeutralFillBrush}"
                    CornerRadius="2" />
                <Border
                    x:Name="ProgressFill"
                    Width="0"
                    Height="4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="2" />
                <Ellipse
                    x:Name="ProgressKnob"
                    Width="9"
                    Height="9"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource TextFillColorPrimaryBrush}"
                    Visibility="Collapsed" />
            </Grid>
            <TextBlock
                x:Name="DurationText"
                Grid.Column="2"
                FontSize="10"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
