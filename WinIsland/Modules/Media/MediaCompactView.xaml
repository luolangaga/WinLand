<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinIsland.Modules.Media.MediaCompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="8,0,14,0" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 封面 -->
        <Border
            Width="26"
            Height="26"
            VerticalAlignment="Center"
            Background="#33FFFFFF"
            CornerRadius="7">
            <Grid>
                <FontIcon
                    FontSize="12"
                    Foreground="White"
                    Glyph="&#xE8D6;"
                    Visibility="{x:Bind ViewModel.PlaceholderVisibility, Mode=OneWay}" />
                <Border CornerRadius="7" Visibility="{x:Bind ViewModel.ThumbnailVisibility, Mode=OneWay}">
                    <Image
                        Width="26"
                        Height="26"
                        Source="{x:Bind ViewModel.Thumbnail, Mode=OneWay}"
                        Stretch="UniformToFill" />
                </Border>
            </Grid>
        </Border>

        <!-- 标题 -->
        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="#D9FFFFFF"
            MaxLines="1"
            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />

        <!-- 跳动的音频条 -->
        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="2">
            <Rectangle
                x:Name="Bar1"
                Width="3"
                Height="8"
                VerticalAlignment="Center"
                Fill="#FF6CCB5F"
                RadiusX="1.5"
                RadiusY="1.5" />
            <Rectangle
                x:Name="Bar2"
                Width="3"
                Height="14"
                VerticalAlignment="Center"
                Fill="#FF6CCB5F"
                RadiusX="1.5"
                RadiusY="1.5" />
            <Rectangle
                x:Name="Bar3"
                Width="3"
                Height="10"
                VerticalAlignment="Center"
                Fill="#FF6CCB5F"
                RadiusX="1.5"
                RadiusY="1.5" />
        </StackPanel>
    </Grid>
</UserControl>
