<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinIsland.Modules.Media.MediaSpotlightView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 聚光卡在浅色主题下是浅底，插件自己的中性色必须成对给出（文字用系统画刷，见下方 ThemeResource） -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SpotlightNeutralFillBrush" Color="#26000000" />
                    <SolidColorBrush x:Key="SpotlightSubtleFillBrush" Color="#14000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SpotlightNeutralFillBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="SpotlightSubtleFillBrush" Color="#14FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="SpotlightTransportButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SpotlightSubtleFillBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="22" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 音乐超级展开卡：左封面 + 右歌词流，底部播控与可拖动进度。
         歌词行在代码里按曲目生成（长栈 + 平移滚动），XAML 只留容器。 -->
    <Grid Padding="26,24,26,20" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="296" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：封面与曲目信息 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Ellipse
                    Width="248"
                    Height="248"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#66FF2D55" />
                            <GradientStop Offset="0.55" Color="#26FF2D55" />
                            <GradientStop Offset="1" Color="#00FF2D55" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Border
                    x:Name="Cover"
                    Width="228"
                    Height="228"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SpotlightNeutralFillBrush}"
                    CornerRadius="20">
                    <Grid>
                        <FontIcon
                            FontSize="56"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8D6;"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.PlaceholderVisibility, Mode=OneWay}" />
                        <Image
                            Source="{x:Bind ViewModel.Thumbnail, Mode=OneWay}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind ViewModel.ThumbnailVisibility, Mode=OneWay}" />
                    </Grid>
                </Border>
            </Grid>

            <TextBlock
                Grid.Row="1"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                MaxLines="2"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Row="2"
                Margin="0,6,0,0"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Row="3"
                Margin="0,3,0,0"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                MaxLines="1"
                Text="{x:Bind ViewModel.AlbumTitle, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <StackPanel
                Grid.Row="4"
                Margin="0,14,0,0"
                Orientation="Horizontal"
                Spacing="6">
                <Image
                    Width="14"
                    Height="14"
                    VerticalAlignment="Center"
                    Source="{x:Bind ViewModel.SourceAppIcon, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.SourceAppIconVisibility, Mode=OneWay}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    MaxLines="1"
                    Text="{x:Bind ViewModel.SourceAppName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- 右：歌词流 / 无歌词时的音浪，底部播控与进度 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid
                    x:Name="LyricsViewport"
                    Height="230"
                    VerticalAlignment="Center">
                    <StackPanel x:Name="LyricsStack" VerticalAlignment="Top">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="LyricsShift" />
                        </StackPanel.RenderTransform>
                    </StackPanel>
                </Grid>

                <StackPanel
                    x:Name="LyricsFallback"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Spacing="20"
                    Visibility="Collapsed">
                    <StackPanel
                        x:Name="Equalizer"
                        Height="64"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Rectangle x:Name="EqBar0" Width="7" Height="10" Fill="#FF6CCB5F" RadiusX="3.5" RadiusY="3.5" VerticalAlignment="Bottom" />
                        <Rectangle x:Name="EqBar1" Width="7" Height="16" Fill="#FF63A6F1" RadiusX="3.5" RadiusY="3.5" VerticalAlignment="Bottom" />
                        <Rectangle x:Name="EqBar2" Width="7" Height="24" Fill="#FFF472B0" RadiusX="3.5" RadiusY="3.5" VerticalAlignment="Bottom" />
                        <Rectangle x:Name="EqBar3" Width="7" Height="16" Fill="#FF63A6F1" RadiusX="3.5" RadiusY="3.5" VerticalAlignment="Bottom" />
                        <Rectangle x:Name="EqBar4" Width="7" Height="10" Fill="#FF6CCB5F" RadiusX="3.5" RadiusY="3.5" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock
                        x:Name="LyricsStatus"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="正在获取歌词…" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="18">
                    <Button
                        Click="Previous_Click"
                        Style="{StaticResource SpotlightTransportButton}"
                        Width="40"
                        Height="40">
                        <FontIcon FontSize="15" Glyph="&#xE892;" />
                    </Button>
                    <Button
                        Click="PlayPause_Click"
                        Style="{StaticResource SpotlightTransportButton}"
                        Width="52"
                        Height="52">
                        <FontIcon FontSize="22" Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" />
                    </Button>
                    <Button
                        Click="Next_Click"
                        Style="{StaticResource SpotlightTransportButton}"
                        Width="40"
                        Height="40">
                        <FontIcon FontSize="15" Glyph="&#xE893;" />
                    </Button>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.SwitcherVisibility, Mode=OneWay}">
                    <Button
                        Click="PrevSession_Click"
                        Style="{StaticResource SpotlightTransportButton}"
                        Width="28"
                        Height="28">
                        <FontIcon FontSize="12" Glyph="&#xE76B;" />
                    </Button>
                    <Button
                        Click="NextSession_Click"
                        Style="{StaticResource SpotlightTransportButton}"
                        Width="28"
                        Height="28">
                        <FontIcon FontSize="12" Glyph="&#xE76C;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="2"
                Margin="0,16,0,0"
                ColumnSpacing="10"
                Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PositionText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                <Grid
                    x:Name="ProgressArea"
                    Grid.Column="1"
                    Height="20"
                    Background="Transparent"
                    PointerCaptureLost="ProgressArea_PointerCaptureLost"
                    PointerMoved="ProgressArea_PointerMoved"
                    PointerPressed="ProgressArea_PointerPressed"
                    PointerReleased="ProgressArea_PointerReleased">
                    <Border
                        Height="5"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SpotlightNeutralFillBrush}"
                        CornerRadius="2.5" />
                    <Border
                        x:Name="ProgressFill"
                        Width="0"
                        Height="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#FFFF2D55"
                        CornerRadius="2.5" />
                    <Ellipse
                        x:Name="ProgressKnob"
                        Width="13"
                        Height="13"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource TextFillColorPrimaryBrush}"
                        Visibility="Collapsed" />
                </Grid>
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
