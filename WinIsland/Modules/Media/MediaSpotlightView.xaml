<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="WinIsland.Modules.Media.MediaSpotlightView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:media="using:WinIsland.Modules.Media"
 xmlns:island="using:WinIsland.Island">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 聚光卡在浅色主题下是浅底，插件自己的中性色必须成对给出（文字用系统画刷，见下方 ThemeResource） -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SpotlightNeutralFillBrush" Color="#26000000" />
                    <SolidColorBrush x:Key="SpotlightSubtleFillBrush" Color="#14000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SpotlightNeutralFillBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="SpotlightSubtleFillBrush" Color="#14FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SpotlightNeutralFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="SpotlightSubtleFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="SpotlightTransportButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SpotlightSubtleFillBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>


 <Grid>
  <island:AmbientBackdrop x:Name="BackgroundScene" />
  <Grid Padding="36,30,36,26" RowSpacing="0">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="44">
    <Grid.ColumnDefinitions><ColumnDefinition Width="0.72*"/><ColumnDefinition Width="1.28*"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Spacing="0">
     <Border x:Name="Cover" Width="208" Height="208" HorizontalAlignment="Left" Background="Transparent" Margin="0,0,0,24">
      <media:AlbumArtView x:Name="CoverArt" PlaceholderSize="52" ArtworkRadius="16" PlaceholderFill="{ThemeResource SpotlightNeutralFillBrush}" Source="{x:Bind ViewModel.Thumbnail, Mode=OneWay}" />
     </Border>
     <TextBlock FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.Title, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
     <TextBlock Margin="0,8,0,0" FontSize="14" Text="{x:Bind ViewModel.Artist, Mode=OneWay}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <TextBlock Margin="0,4,0,0" FontSize="12" Text="{x:Bind ViewModel.AlbumTitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
     <TextBlock Margin="0,16,0,0" FontSize="11" Text="{x:Bind ViewModel.SourceAppName, Mode=OneWay}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
    </StackPanel>
    <Grid Grid.Column="1" RowSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Spacing="6">
      <TextBlock Text="歌词" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBlock x:Name="LyricsHint" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
     </StackPanel>
     <Grid Grid.Row="1">
      <Grid x:Name="LyricsViewport">
       <ScrollViewer x:Name="LyricsScroller" AutomationProperties.AutomationId="LyricsScroller" AutomationProperties.Name="歌词" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
        <StackPanel x:Name="LyricsStack" Padding="12,0,12,0" VerticalAlignment="Top"/>
       </ScrollViewer>
      </Grid>
      <StackPanel x:Name="LyricsFallback" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="18">
       <StackPanel x:Name="WaitingDots" Orientation="Horizontal" Spacing="8" Height="16" Visibility="Collapsed">
        <Ellipse x:Name="WaitDot0" Width="6" Height="6" Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Ellipse x:Name="WaitDot1" Width="6" Height="6" Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Ellipse x:Name="WaitDot2" Width="6" Height="6" Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
       </StackPanel>
       <TextBlock x:Name="LyricsStatus" AutomationProperties.AutomationId="LyricsStatus" FontSize="20" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="正在寻找歌词"/>
      </StackPanel>
     </Grid>
    </Grid>
   </Grid>
            <Grid Grid.Row="1" Margin="0,20,0,0">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="18">
                    <Button
                        AutomationProperties.Name="上一首" AutomationProperties.AutomationId="SpotlightPrevious_Click" Click="Previous_Click"
                        Style="{StaticResource SpotlightTransportButton}"
                        Width="40"
                        Height="40">
                        <FontIcon FontSize="15" Glyph="&#xE892;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="播放或暂停" AutomationProperties.AutomationId="SpotlightPlayPause_Click" Click="PlayPause_Click"
                        Style="{StaticResource SpotlightTransportButton}"
                        Width="52"
                        Height="52">
                        <FontIcon FontSize="22" Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="下一首" AutomationProperties.AutomationId="SpotlightNext_Click" Click="Next_Click"
                        Style="{StaticResource SpotlightTransportButton}"
                        Width="40"
                        Height="40">
                        <FontIcon FontSize="15" Glyph="&#xE893;" />
                    </Button>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.SwitcherVisibility, Mode=OneWay}">
                    <Button
                        AutomationProperties.Name="上一个媒体应用" AutomationProperties.AutomationId="SpotlightPrevSession_Click" Click="PrevSession_Click"
                        Style="{StaticResource SpotlightTransportButton}"
                        Width="28"
                        Height="28">
                        <FontIcon FontSize="12" Glyph="&#xE76B;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="下一个媒体应用" AutomationProperties.AutomationId="SpotlightNextSession_Click" Click="NextSession_Click"
                        Style="{StaticResource SpotlightTransportButton}"
                        Width="28"
                        Height="28">
                        <FontIcon FontSize="12" Glyph="&#xE76C;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="2"
                Margin="0,16,0,0"
                ColumnSpacing="10"
                Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PositionText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                <Grid
                    x:Name="ProgressArea"
                    Grid.Column="1"
                    Height="20"
                    Background="Transparent"
                    PointerCaptureLost="ProgressArea_PointerCaptureLost"
                    PointerMoved="ProgressArea_PointerMoved"
                    PointerPressed="ProgressArea_PointerPressed"
                    PointerReleased="ProgressArea_PointerReleased">
                    <Border
                        Height="5"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SpotlightNeutralFillBrush}"
                        CornerRadius="2.5" />
                    <Border
                        x:Name="ProgressFill"
                        Width="0"
                        Height="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="2.5" />
                    <Ellipse
                        x:Name="ProgressKnob"
                        Width="13"
                        Height="13"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource TextFillColorPrimaryBrush}"
                        Visibility="Collapsed" />
                </Grid>
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
            </Grid>

  </Grid>
 </Grid>
</UserControl>
