<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinIsland.Modules.Media.MediaSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="正在播放" />
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="监听 Windows 系统媒体会话，把正在播放的音乐显示在灵动岛上" />

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel x:Name="BackgroundOptions" />
        </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="小岛播放律动" />
                        <TextBlock Text="播放时显示经典波浪指示，与背景动效独立" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="WaveToggle" Grid.Column="1" AutomationProperties.AutomationId="MediaWaveEnabled" AutomationProperties.Name="小岛播放律动" OffContent="" OnContent="" MinWidth="0" Toggled="WaveToggle_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="启用正在播放" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="播放音乐时在灵动岛常驻显示，悬停可展开播控"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="EnableToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OffContent=""
                        OnContent=""
                        Toggled="EnableToggle_Toggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="音乐律动背景" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="岛体和聚光卡随真实音频节奏律动；暂停时停止"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="GlowToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OffContent=""
                        OnContent=""
                        Toggled="GlowToggle_Toggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="歌词" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="聚光卡跟随歌曲滚动歌词；无播放进度时可手动浏览（需联网）"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="LyricsToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OffContent=""
                        OnContent=""
                        Toggled="LyricsToggle_Toggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="显示优先级" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="数值越高越优先显示在灵动岛上，默认 200（高于 Clash 的 150）"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Slider
                        x:Name="PrioritySlider"
                        Grid.Column="1"
                        Width="200"
                        Maximum="200"
                        Minimum="0"
                        StepFrequency="10"
                        VerticalAlignment="Center"
                        ValueChanged="PrioritySlider_ValueChanged" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="当前状态" />
                    <TextBlock
                        x:Name="StatusText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,6,0,0"
                        Click="Refresh_Click"
                        Content="刷新状态" />
                </StackPanel>
            </Border>
    </StackPanel>
</UserControl>
