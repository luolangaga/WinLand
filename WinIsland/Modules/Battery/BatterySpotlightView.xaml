<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinIsland.Modules.Battery.BatterySpotlightView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 聚光卡在浅色主题下是浅底，插件自己的中性色必须成对给出（文字用系统画刷，见下方 ThemeResource） -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SpotlightRingTrackBrush" Color="#26000000" />
                    <SolidColorBrush x:Key="SpotlightDividerBrush" Color="#14000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SpotlightRingTrackBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="SpotlightDividerBrush" Color="#14FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 电池超级展开卡：左侧大进度环 + 右侧高级信息（容量/健康/循环/电压/预计时间）。
         数值都在代码里填，读不到的项显示 "—"。 -->
    <Grid Padding="28,26,28,22" ColumnSpacing="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Column="0"
            HorizontalAlignment="Center"
            Spacing="16"
            VerticalAlignment="Center">
            <Grid Width="228" Height="228">
                <Ellipse
                    Width="212"
                    Height="212"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Opacity="0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#596CCB5F" />
                            <GradientStop Offset="0.6" Color="#1F6CCB5F" />
                            <GradientStop Offset="1" Color="#006CCB5F" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- 进度环用原生 ProgressRing（确定模式）：Value 就是百分比，
                     自带轨道与圆头弧、数值变化时自带过渡动画，不用手写 dash -->
                <ProgressRing
                    x:Name="FgRing"
                    Width="202"
                    Height="202"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsIndeterminate="False"
                    Foreground="#FF6CCB5F"
                    Background="{ThemeResource SpotlightRingTrackBrush}" />
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="50"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.PercentText, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <!-- 预计时间放在环下面当主角：充电时说"还有多久充满"，放电时说"还能用多久" -->
            <TextBlock
                x:Name="EstimateText"
                MaxWidth="240"
                HorizontalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="—"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Border
                x:Name="StatusPill"
                Padding="14,6,14,6"
                HorizontalAlignment="Center"
                Background="#266CCB5F"
                CornerRadius="12">
                <TextBlock
                    x:Name="PillText"
                    FontSize="12"
                    Foreground="#FF6CCB5F"
                    Text="正在充电" />
            </Border>
        </StackPanel>

        <StackPanel
            x:Name="InfoPanel"
            Grid.Column="1"
            Opacity="0"
            VerticalAlignment="Center">
            <Grid Height="38">
                <TextBlock
                    x:Name="ValuePowerLabel"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="充电功率" />
                <TextBlock
                    x:Name="ValuePowerText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="#FF6CCB5F"
                    Text="—" />
            </Grid>
            <Border Height="1" Background="{ThemeResource SpotlightDividerBrush}" />
            <Grid Height="38">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="剩余容量" />
                <TextBlock
                    x:Name="ValueRemainingText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="—" />
            </Grid>
            <Border Height="1" Background="{ThemeResource SpotlightDividerBrush}" />
            <Grid Height="38">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="满充容量" />
                <TextBlock
                    x:Name="ValueFullText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="—" />
            </Grid>
            <Border Height="1" Background="{ThemeResource SpotlightDividerBrush}" />
            <Grid Height="38">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="设计容量" />
                <TextBlock
                    x:Name="ValueDesignText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="—" />
            </Grid>
            <Border Height="1" Background="{ThemeResource SpotlightDividerBrush}" />
            <Grid Height="38">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="电池健康" />
                <TextBlock
                    x:Name="ValueHealthText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="—" />
            </Grid>
            <Border Height="1" Background="{ThemeResource SpotlightDividerBrush}" />
            <Grid Height="38">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="循环次数" />
                <TextBlock
                    x:Name="ValueCycleText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="—" />
            </Grid>
            <Border Height="1" Background="{ThemeResource SpotlightDividerBrush}" />
            <Grid Height="38">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="电池电压" />
                <TextBlock
                    x:Name="ValueVoltageText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="—" />
            </Grid>
            <Border Height="1" Background="{ThemeResource SpotlightDividerBrush}" />
            <Grid Height="38">
                <TextBlock
                    x:Name="ValueTimeLabel"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="预计充满" />
                <TextBlock
                    x:Name="ValueTimeText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="—" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
