<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinIsland.Modules.Battery.BatteryIslandView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 岛体在浅色主题（Fluent）下是浅底，插件自己的中性色必须成对给出：
                 只写死一套白色，浅色岛上就是白环压白底（文字直接用系统画刷） -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BatteryNeutralStrokeBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="BatteryTrackBrush" Color="#1A000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BatteryNeutralStrokeBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="BatteryTrackBrush" Color="#1AFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- 百分比的两个档位：展开态更亮一档，代码里按形态切换 Style。
                 颜色必须留在 Style 里走 ThemeResource —— 代码里直接赋 Foreground 会打断主题引用，
                 浅色主题下就变成白字压白底。 -->
            <Style x:Key="PercentCompactStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="PercentExpandedStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Padding="8,0,14,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Electric arc layer (charging only) -->
        <Canvas
            x:Name="ArcCanvas"
            Grid.RowSpan="2"
            IsHitTestVisible="False"
            Opacity="0" />

        <!-- Glow layer (expanded + charging only) -->
        <Grid x:Name="GlowLayer" Grid.RowSpan="2" Opacity="0" IsHitTestVisible="False">
            <Ellipse
                x:Name="GlowOrb"
                RenderTransformOrigin="0.5,0.5"
                Opacity="0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="GlowOrbScale" ScaleX="0.6" ScaleY="0.6" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="GlowCenter" Color="#806CCB5F" Offset="0" />
                        <GradientStop x:Name="GlowEdge" Color="#006CCB5F" Offset="0.6" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Main compact row -->
        <Grid x:Name="MainGrid" Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Battery ring：进度环用原生 ProgressRing（确定模式），Value 就是百分比。
                 原生环不跟随容器拉伸（固定 32×32），尺寸由代码按外框 26→48 的动画逐帧同步。 -->
            <Grid
                x:Name="BatteryRing"
                Width="26"
                Height="26"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <ProgressRing
                    x:Name="FgRing"
                    Width="26"
                    Height="26"
                    IsIndeterminate="False"
                    Foreground="#FF6CCB5F"
                    Background="{ThemeResource BatteryNeutralStrokeBrush}" />
                <FontIcon
                    x:Name="CenterIcon"
                    FontSize="10"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Glyph="&#xE859;"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- Percent + Power text -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    x:Name="PercentText"
                    FontSize="12"
                    Style="{StaticResource PercentCompactStyle}"
                    Text="{x:Bind ViewModel.PercentText, Mode=OneWay}" />
                <TextBlock
                    x:Name="PowerText"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.ChargePowerText, Mode=OneWay}" />
            </StackPanel>

            <!-- "正在充电" label -->
            <TextBlock
                x:Name="ChargingLabel"
                Grid.Column="2"
                FontSize="10"
                Foreground="#B06CCB5F"
                Text="正在充电"
                VerticalAlignment="Center"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="ChargingLabelTranslate" X="8" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>

        <!-- Expanded panel：只放"一眼要看"的两个数（功率 / 状态）+ 电量进度条；
             容量、健康度、循环次数、预计时间这些都留给超大卡 -->
        <StackPanel
            x:Name="ExpandedPanel"
            Grid.Row="1"
            Height="0"
            Opacity="0"
            Spacing="8"
            Padding="0,8,0,0">
            <Grid x:Name="ProgressTrack" Height="6" CornerRadius="3" Background="{ThemeResource BatteryTrackBrush}">
                <Rectangle
                    x:Name="ProgressBar"
                    HorizontalAlignment="Left"
                    Width="0"
                    Fill="#FF6CCB5F"
                    RadiusX="3"
                    RadiusY="3" />
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="充电功率" />
                    <TextBlock
                        x:Name="DetailPower"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.ChargePowerText, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="电池状态" />
                    <TextBlock
                        x:Name="DetailStatus"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
