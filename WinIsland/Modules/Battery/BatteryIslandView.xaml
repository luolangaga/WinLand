<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinIsland.Modules.Battery.BatteryIslandView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Padding="8,0,14,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Electric arc layer (charging only) -->
        <Canvas
            x:Name="ArcCanvas"
            Grid.RowSpan="2"
            IsHitTestVisible="False"
            Opacity="0" />

        <!-- Glow layer (expanded + charging only) -->
        <Grid x:Name="GlowLayer" Grid.RowSpan="2" Opacity="0" IsHitTestVisible="False">
            <Ellipse
                x:Name="GlowOrb"
                RenderTransformOrigin="0.5,0.5"
                Opacity="0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="GlowOrbScale" ScaleX="0.6" ScaleY="0.6" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="GlowCenter" Color="#806CCB5F" Offset="0" />
                        <GradientStop x:Name="GlowEdge" Color="#006CCB5F" Offset="0.6" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Main compact row -->
        <Grid x:Name="MainGrid" Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Battery ring -->
            <Grid
                x:Name="BatteryRing"
                Width="26"
                Height="26"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <Ellipse
                    x:Name="BgRing"
                    Stroke="#33FFFFFF"
                    StrokeThickness="3" />
                <Ellipse
                    x:Name="FgRing"
                    Stroke="#FF6CCB5F"
                    StrokeThickness="3"
                    StrokeDashArray="100,100"
                    StrokeDashOffset="100"
                    RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <FontIcon
                    x:Name="CenterIcon"
                    FontSize="10"
                    Foreground="White"
                    Glyph="&#xE859;"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- Percent + Power text -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    x:Name="PercentText"
                    FontSize="12"
                    Foreground="#D9FFFFFF"
                    Text="{x:Bind ViewModel.PercentText, Mode=OneWay}" />
                <TextBlock
                    x:Name="PowerText"
                    FontSize="11"
                    Foreground="#99FFFFFF"
                    Text="{x:Bind ViewModel.ChargePowerText, Mode=OneWay}" />
            </StackPanel>

            <!-- "正在充电" label -->
            <TextBlock
                x:Name="ChargingLabel"
                Grid.Column="2"
                FontSize="10"
                Foreground="#B06CCB5F"
                Text="正在充电"
                VerticalAlignment="Center"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="ChargingLabelTranslate" X="8" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>

        <!-- Expanded panel：进度 + 高级信息（容量 / 健康 / 循环 / 预计时间，数据来自 root\WMI） -->
        <StackPanel
            x:Name="ExpandedPanel"
            Grid.Row="1"
            Height="0"
            Opacity="0"
            Spacing="8"
            Padding="0,9,0,0">
            <Grid x:Name="ProgressTrack" Height="4" CornerRadius="2" Background="#1AFFFFFF">
                <Rectangle
                    x:Name="ProgressBar"
                    HorizontalAlignment="Left"
                    Width="0"
                    Fill="#FF6CCB5F"
                    RadiusX="2"
                    RadiusY="2" />
            </Grid>
            <Grid ColumnSpacing="12" RowSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock FontSize="10" Foreground="#80FFFFFF" Text="充电功率" />
                    <TextBlock
                        x:Name="DetailPower"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{x:Bind ViewModel.ChargePowerText, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock FontSize="10" Foreground="#80FFFFFF" Text="电池状态" />
                    <TextBlock
                        x:Name="DetailStatus"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="—" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock FontSize="10" Foreground="#80FFFFFF" Text="预计充满" />
                    <TextBlock
                        x:Name="DetailTime"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="—" />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="2">
                    <TextBlock FontSize="10" Foreground="#80FFFFFF" Text="满充容量" />
                    <TextBlock
                        x:Name="DetailCapacity"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="—" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                    <TextBlock FontSize="10" Foreground="#80FFFFFF" Text="电池健康" />
                    <TextBlock
                        x:Name="DetailHealth"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="—" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                    <TextBlock FontSize="10" Foreground="#80FFFFFF" Text="循环次数" />
                    <TextBlock
                        x:Name="DetailCycles"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="—" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
