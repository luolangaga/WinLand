<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinIsland.Modules.Battery.BatteryIslandView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Padding="8,0,14,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="GlowLayer" Grid.RowSpan="2" Opacity="0" IsHitTestVisible="False">
            <Ellipse x:Name="Glow1" RenderTransformOrigin="0.35,0.5" Opacity="0.35">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="Glow1Scale" ScaleX="0.50" ScaleY="0.50" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#C06CCB5F" Offset="0" />
                        <GradientStop Color="#406CCB5F" Offset="0.3" />
                        <GradientStop Color="#006CCB5F" Offset="0.75" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="Glow2" RenderTransformOrigin="0.65,0.45" Opacity="0.30">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="Glow2Scale" ScaleX="0.45" ScaleY="0.45" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#B03CB4E0" Offset="0" />
                        <GradientStop Color="#303CB4E0" Offset="0.3" />
                        <GradientStop Color="#003CB4E0" Offset="0.7" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Grid x:Name="MainGrid" Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="BatteryRing"
                Width="26"
                Height="26"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <Ellipse
                    x:Name="BgRing"
                    Stroke="#33FFFFFF"
                    StrokeThickness="3" />
                <Ellipse
                    x:Name="FgRing"
                    Stroke="#FF6CCB5F"
                    StrokeThickness="3"
                    StrokeDashArray="100,100"
                    StrokeDashOffset="100"
                    RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <FontIcon
                    x:Name="CenterIcon"
                    FontSize="10"
                    Foreground="White"
                    Glyph="&#xE859;"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="3">
                <TextBlock
                    x:Name="PercentText"
                    FontSize="12"
                    Foreground="#D9FFFFFF"
                    Text="{x:Bind ViewModel.PercentText, Mode=OneWay}" />
                <TextBlock
                    x:Name="PowerText"
                    Height="0"
                    FontSize="13"
                    Foreground="#99FFFFFF"
                    Opacity="0"
                    Text="{x:Bind ViewModel.ChargePowerText, Mode=OneWay}" />
            </StackPanel>

            <FontIcon
                x:Name="BoltIcon"
                Grid.Column="2"
                FontSize="14"
                Foreground="#FF6CCB5F"
                Glyph="&#xE703;"
                Visibility="{x:Bind ViewModel.ChargingVisibility, Mode=OneWay}"
                VerticalAlignment="Center" />
        </Grid>

        <StackPanel
            x:Name="ExpandedPanel"
            Grid.Row="1"
            Height="0"
            Opacity="0"
            Spacing="8"
            Padding="0,8,0,0">
            <Grid x:Name="ProgressTrack" Height="6" CornerRadius="3" Background="#1AFFFFFF">
                <Rectangle
                    x:Name="ProgressBar"
                    HorizontalAlignment="Left"
                    Width="0"
                    Fill="#FF6CCB5F"
                    RadiusX="3"
                    RadiusY="3" />
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock FontSize="11" Foreground="#80FFFFFF" Text="充电功率" />
                    <TextBlock
                        x:Name="DetailPower"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{x:Bind ViewModel.ChargePowerText, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock FontSize="11" Foreground="#80FFFFFF" Text="电池状态" />
                    <TextBlock
                        x:Name="DetailStatus"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
