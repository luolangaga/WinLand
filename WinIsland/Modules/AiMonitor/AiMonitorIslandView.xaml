<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinIsland.Modules.AiMonitor.AiMonitorIslandView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Padding="8,0,14,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Glow layer (expanded + running): multi-orb aurora -->
        <Grid x:Name="GlowLayer" Grid.RowSpan="3" Opacity="0" IsHitTestVisible="False">
            <Ellipse
                x:Name="GlowOrb1"
                RenderTransformOrigin="0.3,0.5"
                Opacity="0.35">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="Glow1Scale" ScaleX="0.4" ScaleY="0.4" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#B06CCB5F" Offset="0" />
                        <GradientStop Color="#306CCB5F" Offset="0.3" />
                        <GradientStop Color="#006CCB5F" Offset="0.7" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse
                x:Name="GlowOrb2"
                RenderTransformOrigin="0.7,0.4"
                Opacity="0.30">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="Glow2Scale" ScaleX="0.35" ScaleY="0.35" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#B014B8A6" Offset="0" />
                        <GradientStop Color="#3014B8A6" Offset="0.3" />
                        <GradientStop Color="#0014B8A6" Offset="0.7" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse
                x:Name="GlowOrb3"
                RenderTransformOrigin="0.5,0.7"
                Opacity="0.25">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="Glow3Scale" ScaleX="0.30" ScaleY="0.30" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A060CDFF" Offset="0" />
                        <GradientStop Color="#3060CDFF" Offset="0.3" />
                        <GradientStop Color="#0060CDFF" Offset="0.65" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- Scan line (expanded + running): sweeping horizontal light bar -->
        <Rectangle
            x:Name="ScanLine"
            Grid.RowSpan="3"
            Height="2"
            Opacity="0"
            IsHitTestVisible="False"
            VerticalAlignment="Top">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#006CCB5F" Offset="0" />
                    <GradientStop Color="#CC6CCB5F" Offset="0.4" />
                    <GradientStop Color="#FF14B8A6" Offset="0.5" />
                    <GradientStop Color="#CC6CCB5F" Offset="0.6" />
                    <GradientStop Color="#006CCB5F" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="ScanLineTranslate" Y="0" />
            </Rectangle.RenderTransform>
        </Rectangle>

        <!-- Pulse ring (compact + running): expanding ring around icon -->
        <Ellipse
            x:Name="PulseRing"
            Grid.Row="0"
            Width="26"
            Height="26"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="0,0,0,0"
            Stroke="#FF6CCB5F"
            StrokeThickness="1.5"
            Opacity="0"
            IsHitTestVisible="False"
            RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="PulseRingScale" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Main compact row: icon + task name + spinner -->
        <Grid x:Name="MainGrid" Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status icon with rotating ring -->
            <Grid
                x:Name="IconBox"
                Width="26"
                Height="26"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <Border
                    x:Name="IconBg"
                    Background="#226CCB5F"
                    CornerRadius="7">
                    <FontIcon
                        x:Name="StatusIcon"
                        FontSize="12"
                        Foreground="#FF6CCB5F"
                        Glyph="{x:Bind ViewModel.StatusGlyph, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <!-- Arc spinner (expanded + running): rotating dashed ring -->
                <Ellipse
                    x:Name="ArcSpinner"
                    Stroke="#FF6CCB5F"
                    StrokeThickness="2"
                    StrokeDashArray="4,4"
                    StrokeDashOffset="0"
                    Opacity="0"
                    IsHitTestVisible="False"
                    RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="ArcSpinnerRotate" Angle="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <!-- Task name + detail -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    x:Name="TaskNameText"
                    FontSize="12"
                    Foreground="#D9FFFFFF"
                    MaxLines="1"
                    Text="{x:Bind ViewModel.TaskName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="DetailText"
                    Height="0"
                    FontSize="12"
                    Foreground="#99FFFFFF"
                    MaxLines="1"
                    Opacity="0"
                    Text="{x:Bind ViewModel.Detail, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Spinning dots (compact, running) -->
            <StackPanel
                x:Name="Spinner"
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="3">
                <Ellipse
                    x:Name="Dot1"
                    Width="4"
                    Height="4"
                    Fill="#FF6CCB5F"
                    Opacity="0.3" />
                <Ellipse
                    x:Name="Dot2"
                    Width="4"
                    Height="4"
                    Fill="#FF14B8A6"
                    Opacity="0.6" />
                <Ellipse
                    x:Name="Dot3"
                    Width="4"
                    Height="4"
                    Fill="#FF60CDFF"
                    Opacity="1.0" />
            </StackPanel>
        </Grid>

        <!-- Progress bar (expanded) with flowing gradient -->
        <Grid
            x:Name="ProgressRow"
            Grid.Row="1"
            Height="0"
            Opacity="0"
            ColumnSpacing="8"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.HasProgress, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="ProgressLabel"
                Grid.Column="0"
                FontSize="10"
                Foreground="#80FFFFFF"
                VerticalAlignment="Center"
                Text="进度" />
            <ProgressBar
                x:Name="ProgressBar"
                Grid.Column="1"
                Minimum="0"
                Maximum="1"
                Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="ProgressPct"
                Grid.Column="2"
                FontSize="10"
                Foreground="#80FFFFFF"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
        </Grid>

        <!-- Expanded detail panel -->
        <StackPanel
            x:Name="ExpandedPanel"
            Grid.Row="2"
            Height="0"
            Opacity="0"
            Spacing="4"
            Padding="0,8,0,0">
            <TextBlock
                x:Name="RunningLabel"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="White"
                Text="{x:Bind ViewModel.Detail, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />
            <TextBlock
                x:Name="SubDetailText"
                FontSize="11"
                Foreground="#80FFFFFF"
                Text="{x:Bind ViewModel.SubDetail, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />
        </StackPanel>
    </Grid>
</UserControl>
