<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinIsland.Modules.AiMonitor.AiMonitorSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="AI 任务监控" />
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="监控 OpenCode AI 任务状态，在灵动岛上实时显示进度" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="启用 AI 监控" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="AI 任务运行时在灵动岛显示进度，悬停展开查看详情" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="EnableToggle"
                        Grid.Column="1"
                        Margin="0,0,-110,0"
                        Toggled="EnableToggle_Toggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="显示优先级" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="数值越高越优先显示在灵动岛上，默认 80" />
                    </StackPanel>
                    <Slider
                        x:Name="PrioritySlider"
                        Grid.Column="1"
                        Width="200"
                        Maximum="200"
                        Minimum="0"
                        StepFrequency="10"
                        ValueChanged="PrioritySlider_ValueChanged" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="OpenCode 插件" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            x:Name="InstallHint"
                            Text="安装到 OpenCode 全局插件目录，自动连接 WinIsland" />
                    </StackPanel>
                    <Button
                        x:Name="InstallButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="Install_Click"
                        Content="安装" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="连接状态" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            x:Name="StatusDot"
                            Width="8"
                            Height="8"
                            Fill="#FF6CCB5F"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="StatusText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Margin="0,6,0,0"
                        Click="Refresh_Click"
                        Content="刷新状态" />
                </StackPanel>
            </Border>
    </StackPanel>
</UserControl>
