<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinIsland.Modules.AcpMonitor.AcpMonitorSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="Agent 监控" />

            <TextBlock
                x:Name="StatusBlock"
                FontSize="13"
                Foreground="#99FFFFFF"
                Text="等待插件上报"
                TextWrapping="Wrap" />

            <!-- Enable toggle -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="启用 Agent 监控" />
                <ToggleSwitch
                    x:Name="EnabledToggle"
                    Grid.Column="1"
                    IsOn="True"
                    OffContent="关"
                    OnContent="开"
                    Toggled="EnabledToggle_Toggled" />
            </Grid>

            <!-- Callback server info -->
            <Border
                Background="#14FFFFFF"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="回调服务器" />
                    <TextBlock
                        x:Name="CallbackUrlBlock"
                        FontSize="12"
                        Foreground="#99FFFFFF"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="11"
                        Foreground="#80FFFFFF"
                        TextWrapping="Wrap"
                        Text="插件通过此地址向灵动岛上报事件。所有模块共用一个 HTTP 服务器。" />
                </StackPanel>
            </Border>

            <!-- Plugin install section -->
            <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Text="安装 Agent 插件" />
            <TextBlock
                FontSize="12"
                Foreground="#99FFFFFF"
                TextWrapping="Wrap"
                Text="为每个 AI Agent 安装插件，使其自动向灵动岛上报执行状态。点击安装即可自动写入插件文件。" />

            <!-- OpenCode plugin -->
            <Border
                x:Name="OpenCodeCard"
                Background="#0AFFFFFF"
                CornerRadius="8"
                Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="#332ECC71" CornerRadius="8">
                        <FontIcon FontSize="16" Foreground="#FF2ECC71" Glyph="&#xE943;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="OpenCode" />
                        <TextBlock x:Name="OpenCodeStatus" FontSize="11" Foreground="#80FFFFFF" Text="未安装" />
                    </StackPanel>
                    <Button
                        x:Name="InstallOpenCodeBtn"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="InstallOpenCode_Click" />
                </Grid>
            </Border>

            <!-- Claude Code plugin -->
            <Border
                x:Name="ClaudeCard"
                Background="#0AFFFFFF"
                CornerRadius="8"
                Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="#33DE8522" CornerRadius="8">
                        <FontIcon FontSize="16" Foreground="#FFDE8522" Glyph="&#xE8F1;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="Claude Code" />
                        <TextBlock x:Name="ClaudeStatus" FontSize="11" Foreground="#80FFFFFF" Text="未安装" />
                    </StackPanel>
                    <Button
                        x:Name="InstallClaudeBtn"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="InstallClaude_Click" />
                </Grid>
            </Border>

            <!-- Codex plugin -->
            <Border
                x:Name="CodexCard"
                Background="#0AFFFFFF"
                CornerRadius="8"
                Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="#333498DB" CornerRadius="8">
                        <FontIcon FontSize="16" Foreground="#FF3498DB" Glyph="&#xE912;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="Codex CLI" />
                        <TextBlock x:Name="CodexStatus" FontSize="11" Foreground="#80FFFFFF" Text="未安装" />
                    </StackPanel>
                    <Button
                        x:Name="InstallCodexBtn"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="InstallCodex_Click" />
                </Grid>
            </Border>

            <!-- How it works -->
            <Border
                Background="#14FFFFFF"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="工作原理" />
                    <TextBlock
                        FontSize="12"
                        Foreground="#99FFFFFF"
                        TextWrapping="Wrap"
                        Text="1. WinIsland 启动一个本地 HTTP 回调服务器&#x0a;2. 为每个 Agent 安装对应的插件（写入插件目录）&#x0a;3. 插件通过 HTTP hooks 主动上报事件（会话开始/结束、工具调用等）&#x0a;4. 灵动岛实时显示 Agent 执行状态" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
